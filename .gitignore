# Ficheros que git debe ignorar
# Fichero oculto que crea macOS en cada carpeta
.DS_Store

# Dependencias instaladas por npm (se regeneran con npm install)
node_modules/

# Código compilado del backend (se regenera con npm run build)
dist/

# Caché del compilador de TypeScript
*.tsbuildinfo

# Resultados e informes de Playwright (se regeneran al pasar los tests)
test-results/
playwright-report/
